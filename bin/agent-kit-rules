#!/usr/bin/env python3
"""Install or update agent-kit's always-loaded rules in agent instructions.

The rules live in AGENTS.snippet.md between BEGIN and END agent-kit markers.
Installed, the BEGIN marker carries a hash of the text it wraps, so a later
run can tell an untouched snippet, which it replaces wherever it now sits,
from one the user edited, which it leaves alone unless forced.

The records section is included only when `agent-task doctor` and
`agent-changelog doctor` both pass here, once, at install time: agents then
read whether the tools apply instead of each probing them.
"""

from __future__ import annotations

import argparse
import difflib
import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(os.path.realpath(__file__)).parent
SNIPPET = HERE.parent / "AGENTS.snippet.md"
BEGIN_RE = re.compile(r"<!-- BEGIN agent-kit(?: sha256=([0-9a-f]{64}))? -->\n")
END = "<!-- END agent-kit -->"
RECORDS_RE = re.compile(
  r"<!-- agent-kit:records -->\n(.*?)<!-- /agent-kit:records -->\n", re.S)
# Bodies of released snippets that predate the hash in the marker.
RELEASED = {
  "453e4f32a585a11bfea2b9df520304f68b2066d76e9ebe7190be5afde48a10c5",
}
DOCTORS = ("agent-task", "agent-changelog")


def digest(text: str) -> str:
  return hashlib.sha256(text.encode()).hexdigest()


def records_ready(tools: Path = HERE) -> tuple[bool, str | None]:
  """Whether both records tools pass their doctor here, and why not."""
  for name in DOCTORS:
    tool = tools / name
    command = str(tool) if tool.exists() else shutil.which(name)
    if not command:
      return False, f"{name} not found"
    try:
      result = subprocess.run([command, "doctor"], capture_output=True,
                              text=True, timeout=180)
    except (OSError, subprocess.TimeoutExpired) as exc:
      return False, f"{name} doctor: {exc}"
    if result.returncode != 0:
      lines = (result.stderr or result.stdout).strip().splitlines()
      return False, f"{name} doctor: " + (lines[-1] if lines else
                                          f"exit {result.returncode}")
  return True, None


def snippet_body(records: bool) -> str:
  text = SNIPPET.read_text()
  match = re.search(r"<!-- BEGIN agent-kit -->\n(.*?)" + re.escape(END),
                    text, re.S)
  if not match:
    raise SystemExit(f"agent-kit-rules: no snippet markers in {SNIPPET}")
  return RECORDS_RE.sub(lambda m: m.group(1) if records else "",
                        match.group(1))


def block(body: str) -> str:
  return f"<!-- BEGIN agent-kit sha256={digest(body)} -->\n{body}{END}"


def locate(text: str):
  """(start, end, body, recorded hash) of the one snippet, None when there
  is none, or a string saying why the markers cannot be trusted."""
  begins = list(BEGIN_RE.finditer(text))
  ends = [m.start() for m in re.finditer(re.escape(END), text)]
  stray = len(re.findall(r"<!-- BEGIN agent-kit", text))
  if not begins and not ends and not stray:
    return None
  if len(begins) != 1 or len(ends) != 1 or stray != 1:
    return (f"{stray} BEGIN and {len(ends)} END agent-kit markers; "
            "expected one of each")
  begin, end = begins[0], ends[0]
  if end < begin.end():
    return "agent-kit markers are out of order (END before BEGIN)"
  return (begin.start(), end + len(END), text[begin.end():end],
          begin.group(1))


def planned(text: str, new_block: str, force: bool):
  """(new text, what happened) or (None, why it was refused)."""
  found = locate(text)
  if isinstance(found, str):
    return None, found + "; fix them by hand"
  if found is None:
    # One blank line between the existing text and the snippet.
    gap = ("" if not text or text.endswith("\n\n")
           else "\n" if text.endswith("\n") else "\n\n")
    return text + gap + new_block + "\n", "appended"
  start, end, body, recorded = found
  if text[start:end] == new_block:
    return text, "up to date"
  untouched = digest(body) == recorded or digest(body) in RELEASED
  if not untouched and not force:
    return None, ("snippet edited since it was installed; --dry-run shows "
                  "the change, --force replaces it")
  line = text.count("\n", 0, start) + 1
  return text[:start] + new_block + text[end:], f"replaced at line {line}"


def write(path: Path, text: str) -> None:
  """Replace the file atomically, keeping its mode; follows symlinks."""
  real = Path(os.path.realpath(path))
  real.parent.mkdir(parents=True, exist_ok=True)
  mode = real.stat().st_mode & 0o7777 if real.exists() else 0o644
  fd, tmp = tempfile.mkstemp(dir=real.parent, prefix=f".{real.name}.")
  try:
    with os.fdopen(fd, "w") as handle:
      handle.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, real)
  except BaseException:
    Path(tmp).unlink(missing_ok=True)
    raise


def default_targets(home: Path) -> list[Path]:
  """Instruction files for the agents present in this home directory."""
  return [home / tool / name for tool, name in ((".claude", "CLAUDE.md"),
                                                (".codex", "AGENTS.md"))
          if (home / tool).is_dir()]


def install(paths: list[Path], records: str, force: bool, dry_run: bool,
            out=sys.stdout) -> int:
  if records == "auto":
    ready, why = records_ready()
  else:
    ready, why = records == "on", "--records off"
  if not ready:
    print(f"records section omitted: {why}", file=out)
  new_block = block(snippet_body(ready))
  refused = 0
  for path in paths:
    real = Path(os.path.realpath(path))
    text = real.read_text() if real.exists() else ""
    result, what = planned(text, new_block, force)
    shown = str(path) + (f" -> {real}" if path.is_symlink() else "")
    if result is None:
      refused += 1
      print(f"{shown}: refused: {what}", file=out)
      continue
    if dry_run:
      print(f"{shown}: would be {what}", file=out)
      out.writelines(difflib.unified_diff(
        text.splitlines(True), result.splitlines(True), str(path),
        str(path)))
      continue
    if result != text:
      write(path, result)
    print(f"{shown}: {what}", file=out)
  return 1 if refused else 0


def main(argv: list[str] | None = None) -> int:
  parser = argparse.ArgumentParser(
    description="Install or update agent-kit's always-loaded rules. Exit "
                "codes: 0 done; 1 a file was refused and left unchanged; "
                "2 usage.",
    epilog="Example: agent-kit-rules --dry-run")
  parser.add_argument(
    "paths", nargs="*", type=Path,
    help="instruction files (default: ~/.claude/CLAUDE.md and "
         "~/.codex/AGENTS.md, for the agents installed)")
  parser.add_argument(
    "--records", choices=("auto", "on", "off"), default="auto",
    help="include the task and changelog rules: auto runs both doctors "
         "(default)")
  parser.add_argument("--force", action="store_true",
                      help="replace a snippet edited since it was installed")
  parser.add_argument("--dry-run", action="store_true",
                      help="show the changes without writing")
  args = parser.parse_args(argv)
  paths = args.paths or default_targets(Path.home())
  if not paths:
    parser.error("no ~/.claude or ~/.codex here; name the files to update")
  return install(paths, args.records, args.force, args.dry_run)


if __name__ == "__main__":
  sys.exit(main())
