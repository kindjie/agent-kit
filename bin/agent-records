#!/usr/bin/env python3
"""Set up explicit local starter repositories for agent records."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import socket
import subprocess
import sys

# Reading records must not create bytecode caches beside installed modules.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent))

from agent_records_core import (RecordsError, create_exclusive, init_repo,
                                unexpected_error)


def xdg_path(name, fallback):
  value = os.environ.get(name)
  if value is None:
    return Path.home() / fallback
  path = Path(value)
  if not value or not path.is_absolute():
    raise RecordsError(name + " must be an absolute directory", 2)
  return path


def init_default(name):
  raw_config = (xdg_path("XDG_CONFIG_HOME", ".config") /
                "agent-kit/records.json")
  raw_data = xdg_path("XDG_DATA_HOME", ".local/share") / "agent-kit"
  raw_tasks = raw_data / "tasks"
  raw_changes = raw_data / "changelog"
  config = raw_config.resolve()
  tasks = raw_tasks.resolve()
  changes = raw_changes.resolve()
  chosen_machine = name if name is not None else socket.gethostname().split(
    ".")[0]
  if not chosen_machine or "\n" in chosen_machine or "\r" in chosen_machine:
    raise RecordsError("machine name must be one nonempty line", 2)

  for key in ("AGENT_TASKS_DIR", "AGENT_CHANGELOG_DIR", "AGENT_MACHINE"):
    if os.environ.get(key):
      raise RecordsError(key + " is set; remove the override before setup", 2)
  for label, raw, path in (("configuration", raw_config, config),
                           ("tasks", raw_tasks, tasks),
                           ("changelog", raw_changes, changes)):
    if os.path.lexists(raw) or os.path.lexists(path):
      raise RecordsError(label + " destination already exists: " +
                         str(path) + "; existing state is untouched", 2)
  # Each store's first commit needs one; check before creating anything.
  identity = subprocess.run(["git", "var", "GIT_COMMITTER_IDENT"],
                            capture_output=True, text=True)
  if identity.returncode != 0:
    raise RecordsError("no git identity: set user.name and user.email "
                       "(git config --global) before setup", 2)

  print("config: " + str(config))
  print("tasks: " + str(tasks))
  print("changelog: " + str(changes))
  print("machine: " + chosen_machine)
  print("push: false")
  print("scope: local starter queue")

  initialized = []
  try:
    init_repo(tasks, "tasks")
    initialized.append(tasks)
    init_repo(changes, "changelog")
    initialized.append(changes)
    payload = {"tasks_dir": str(tasks), "changelog_dir": str(changes),
               "machine": chosen_machine, "push": False}
    create_exclusive(config, (json.dumps(payload, indent=2) + "\n").encode())
  except (RecordsError, OSError) as exc:
    if initialized:
      print("Initialization stopped after creating: " +
            ", ".join(map(str, initialized)) + ".", file=sys.stderr)
      print("Configuration was not published. Preserve these stores; "
            "inspect the error and recover manually before retrying. "
            "The setup command refuses existing destinations.",
            file=sys.stderr)
    if isinstance(exc, RecordsError):
      raise
    raise RecordsError(str(exc), 1) from exc
  print("Initialized both stores and published configuration.")


def main():
  parser = argparse.ArgumentParser(
    description="Initialize an explicit local starter records queue.")
  sub = parser.add_subparsers(dest="command", required=True)
  init = sub.add_parser("init", help="initialize both records stores")
  init.add_argument("--default", action="store_true", required=True,
                    help="use XDG config and data paths")
  init.add_argument("--machine", help="stable machine name to record")
  args = parser.parse_args()
  init_default(args.machine)
  return 0


if __name__ == "__main__":
  try:
    sys.exit(main())
  except RecordsError as exc:
    print(str(exc), file=sys.stderr)
    sys.exit(exc.code)
  except Exception as exc:
    sys.exit(unexpected_error(exc))
