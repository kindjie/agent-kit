#!/usr/bin/env python3
"""Share and inspect SteamOS devices (Steam Deck, Steam Machine) over ssh.

Device facts come from the device itself over one ssh call per command.
Configuration lives in $XDG_CONFIG_HOME/agent-kit/steamos.json; see
steamos.md beside this file.
"""
import argparse
import getpass
import ipaddress
import json
import os
import re
import signal
from pathlib import Path
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time

sys.path.insert(0, str(Path(__file__).resolve().parent))
import steamos_deploy as publication

OK, REFUSED, USAGE, UNREACHABLE = 0, 1, 2, 3
BENCH_FAILED = 4
DEFAULT_KEY = Path('~/.config/steamos-devkit/devkit_rsa')
# Valve's SteamOS Devkit source and the commit whose device-side helpers
# (client/devkit-utils) steamos installs; configurable under "devkit".
DEVKIT_SOURCE = 'https://gitlab.steamos.cloud/devkit/steamos-devkit.git'
DEVKIT_COMMIT = 'a00ceb7d91ea44a0c3e714a91a06417d6e5cdb33'
DEVKIT_PIN_FILE = '.agent-kit-pin'
COMMIT = re.compile(r'[0-9a-f]{40}')
SAFE_PATH = re.compile(r'[A-Za-z0-9._-][A-Za-z0-9._/-]*')
TITLE_NAME = re.compile(r'[A-Za-z0-9]+')

# Every device script starts by printing this line, so a dropped
# connection after the script began is not mistaken for one that never
# connected (and the command is not retried at another address).
PREAMBLE = 'echo connected=1\n'

# Runs on the device with HOME as its root. POSIX sh; Linux-only sleep
# inhibition is optional so the lease also works on the macOS test host.
# Prints key=value lines; exit 0 on success, 1 when refused.
#
# Every change to the lease happens while holding a mutex directory, so
# take, renew, release, reclaim and break never interleave. The mutex
# holds an owner token: a stale one (older than two minutes) is renamed
# aside and removed only if it is still the one judged stale. Functions
# return explicit statuses because `set -e` does not apply inside `if`.
LEASE_SCRIPT = r'''
set -eu
action=$1 holder=$2 purpose=$3 seconds=$4 grace=$5 reason=$6 prevent_sleep=$7
shift 7
legacy_paths=$*
lock=$HOME/.agent-kit-steamos-lease
info=$lock/info
mutex=$lock.mutex
log=$HOME/.agent-kit-steamos-lease.log
now=$(date +%s)
token=$$.$now
fresh='' owned='' pending_unit='' inhibit_failed=''
unit=agent-kit-steamos-lease-inhibit
cleanup() {
  if [ -n "$pending_unit" ]; then
    systemctl --user stop "$unit" >/dev/null 2>&1 || true
  fi
  if [ -n "$fresh" ]; then rm -rf -- "$lock"; fi
  if [ -n "$owned" ] && [ "$(cat "$mutex/owner" 2>/dev/null)" = "$token" ]
  then rm -rf -- "$mutex"
  fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
field() { sed -n "s/^$1=//p" "$info" 2>/dev/null | head -n 1; }
user_manager_available() {
  command -v systemctl >/dev/null 2>&1 &&
    systemctl --user show-environment >/dev/null 2>&1
}
inhibitor_active() {
  [ "$(systemctl --user is-active "$unit" 2>/dev/null)" = active ]
}
inhibitor_holds() {
  inhibitor_active && systemd-inhibit --list 2>/dev/null |
    awk '$1 == "agent-kit-steamos" { found=1 } END { exit !found }'
}
stop_inhibitor() {
  user_manager_available || return 0
  # A missing collected unit also returns nonzero from stop. Refuse only
  # if the unit is still active; never signal a PID from a lease record.
  if ! systemctl --user stop "$unit" >/dev/null 2>&1; then
    inhibitor_active && return 1
  fi
  return 0
}
inhibit_available() {
  command -v systemd-run >/dev/null 2>&1 &&
    command -v systemd-inhibit >/dev/null 2>&1 &&
    user_manager_available
}
start_inhibitor() {
  stop_inhibitor || return 1
  [ "$prevent_sleep" = true ] || return 0
  inhibit_available || return 0
  left=$(( $(field expires) - $(date +%s) ))
  [ "$left" -gt 0 ] || return 0
  # The user manager owns this process outside sshd's session scope, so
  # logind session cleanup cannot kill it. sleep bounds its lifetime.
  pending_unit=1
  systemd-run --user --unit="$unit" --collect --quiet \
    systemd-inhibit --what=sleep:idle --who=agent-kit-steamos \
    --why="steamos lease: $holder" --mode=block sleep "$left" \
    >/dev/null 2>&1 || return 1
  sleep 0.5
  inhibitor_holds || return 1
  pending_unit=''
  return 0
}
# state: free, broken (a lock without info: being taken, or left behind),
# active, expired (within grace) or reclaimable.
state() {
  if [ ! -d "$lock" ]; then echo free
  elif [ ! -f "$info" ]; then
    if [ -n "$(find "$lock" -maxdepth 0 -mmin +"$grace" 2>/dev/null)" ]; then
      echo reclaimable
    else
      echo broken
    fi
  else
    expires=$(field expires)
    case $expires in
      ''|*[!0-9]*) echo broken; return ;;
    esac
    if [ "$now" -lt "$expires" ]; then echo active
    elif [ "$now" -lt $((expires + grace * 60)) ]; then echo expired
    else echo reclaimable
    fi
  fi
}
legacy=''
for path in $legacy_paths; do
  if [ -e "$HOME/$path" ]; then legacy=$path; fi
done
emit() {
  printf 'state=%s\nnow=%s\n' "$(state)" "$now"
  # Reads without the mutex may race a removal; a vanished file is free.
  sed 's/^/lease_/' "$info" 2>/dev/null || true
  if [ -n "$inhibit_failed" ]; then echo inhibit=failed
  elif inhibit_available && inhibitor_holds; then echo inhibit=active
  elif [ ! -d "$lock" ]; then echo inhibit=inactive
  elif [ "$prevent_sleep" != true ]; then echo inhibit=disabled
  elif ! inhibit_available; then echo inhibit=unavailable
  else echo inhibit=inactive
  fi
  for path in $legacy_paths; do
    if [ -e "$HOME/$path" ]; then
      printf 'legacy=%s\n' "$path"
      if [ -f "$HOME/$path/info" ]; then
        printf 'legacy_info=%s: %s\n' "$path" \
          "$(tr '\n' ' ' <"$HOME/$path/info" 2>/dev/null || true)"
      fi
    fi
  done
}
finish() { printf 'result=%s\n' "$1"; emit; exit "$2"; }
mine() { [ -f "$info" ] && [ "$(field holder)" = "$holder" ]; }
record() { printf '%s %s by=%s %s\n' "$now" "$1" "$holder" "$2" >>"$log"; }
lock_mutex() {
  if [ -n "$(find "$mutex" -maxdepth 0 -mmin +2 2>/dev/null)" ]; then
    stale=$(cat "$mutex/owner" 2>/dev/null || echo none)
    aside=$mutex.stale.$$
    if mv "$mutex" "$aside" 2>/dev/null; then
      if [ "$(cat "$aside/owner" 2>/dev/null || echo none)" = "$stale" ]
      then
        rm -rf -- "$aside"
      elif [ ! -e "$mutex" ]; then
        # Someone else's live mutex: put it back. If that fails it stays
        # aside for the sweep, never deleted while it may be in use.
        mv "$aside" "$mutex" 2>/dev/null || true
      fi
    fi
  fi
  mkdir "$mutex" 2>/dev/null || return 1
  owned=1
  printf '%s\n' "$token" >"$mutex/owner" || return 1
  # Leftovers of interrupted runs, once they are older than the grace.
  find "$HOME" -maxdepth 1 \( -name '.agent-kit-steamos-lease.removed.*' \
    -o -name '.agent-kit-steamos-lease.mutex.stale.*' \) \
    -mmin +"$grace" -exec rm -rf {} + 2>/dev/null || true
}
# remove_lock EVENT DETAIL: moves the lock aside in one rename, logs its
# info, then deletes it.
remove_lock() {
  stop_inhibitor || return 1
  aside=$lock.removed.$now.$$
  mv "$lock" "$aside" 2>/dev/null || return 1
  record "$1" "$2 $(tr '\n' ' ' <"$aside/info" 2>/dev/null || true)" ||
    true
  rm -rf -- "$aside"
}
write() {
  new=$lock/info.new.$$
  printf 'holder=%s\npurpose=%s\nstart=%s\nexpires=%s\n' \
    "$holder" "$purpose" "$1" "$((now + seconds))" >"$new" || return 1
  mv -f "$new" "$info" || return 1
  if ! start_inhibitor; then
    inhibit_failed=1
    if [ -n "$pending_unit" ]; then
      systemctl --user stop "$unit" >/dev/null 2>&1 || true
    fi
  fi
  return 0
}
take_new() {
  mkdir "$lock" 2>/dev/null || return 1
  fresh=1
  write "$now" || return 1
  fresh=''
}
case $action in
  take)
    if [ -n "$legacy" ]; then finish legacy 1; fi
    lock_mutex || finish busy 1
    current=$(state)
    if [ "$current" = free ]; then
      take_new && finish took 0 || finish failed 1
    elif mine; then
      write "$(field start)" && finish refreshed 0 || finish failed 1
    elif [ "$current" = reclaimable ]; then
      remove_lock reclaimed '' || finish gone 1
      take_new && finish reclaimed 0 || finish failed 1
    fi
    finish held 1 ;;
  renew)
    lock_mutex || finish busy 1
    if mine; then
      write "$(field start)" && finish refreshed 0 || finish failed 1
    fi
    finish notmine 1 ;;
  release)
    lock_mutex || finish busy 1
    if [ ! -d "$lock" ]; then finish free 0; fi
    if mine; then
      remove_lock released '' && finish released 0
      finish gone 1
    fi
    finish notmine 1 ;;
  break)
    lock_mutex || finish busy 1
    if [ ! -d "$lock" ]; then finish free 0; fi
    remove_lock broken "reason=$reason" && finish broke 0
    finish gone 1 ;;
  check)
    if mine; then
      if [ "$(state)" = active ]; then finish ok 0; fi
      finish expired 1
    fi
    finish notmine 1 ;;
  show) finish shown 0 ;;
esac
'''

# Shared read-only power fields, also saved with benchmark results.
POWER_SCRIPT = r'''
for supply in "${STEAMOS_TEST_SYSFS:-/sys}"/class/power_supply/*; do
  [ -r "$supply/type" ] || continue
  case $(cat "$supply/type") in
    Mains|USB)
      if [ "$(cat "$supply/online" 2>/dev/null)" = 1 ]; then
        echo external_power=yes
      fi ;;
    Battery)
      echo "battery_percent=$(cat "$supply/capacity" 2>/dev/null)"
      echo "battery_status=$(cat "$supply/status" 2>/dev/null)" ;;
  esac
done
'''

# Read-only device facts. Prints key=value lines.
STATUS_SCRIPT = r'''
if [ -r /etc/os-release ]; then
  . /etc/os-release
fi
echo "os_name=${PRETTY_NAME-}"
echo "os_version=${VERSION_ID-}"
echo "os_build=${BUILD_ID-}"
echo "os_variant=${VARIANT_ID-}"
echo "channel=$(steamos-select-branch -c 2>/dev/null || true)"
echo "model=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)"
echo "hostname=$(uname -n)"
echo "free_bytes=$(df -Pk "$HOME" | awk 'NR == 2 { print $4 * 1024 }')"
echo "uptime_seconds=$(cut -d. -f1 /proc/uptime 2>/dev/null || true)"
if [ -d "$HOME/devkit-utils" ]; then
  echo devkit_utils=yes
  echo "devkit_commit=$(head -n 1 "$HOME/devkit-utils/.agent-kit-pin" \
    2>/dev/null || true)"
else echo devkit_utils=no
fi
''' + POWER_SCRIPT


def error_text(message):
  """Keep the transport marker out of all user-facing diagnostics."""
  return str(message).replace('connected=1', '').strip()


class Failure(Exception):
  def __init__(self, code, message):
    super().__init__(error_text(message))
    self.code = code


def config_path():
  root = os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config'
  return Path(root) / 'agent-kit' / 'steamos.json'


def load_config():
  path = config_path()
  try:
    config = json.loads(path.read_text())
  except FileNotFoundError:
    raise Failure(USAGE, f'no configuration at {path}; see steamos.md')
  except (OSError, ValueError) as error:
    raise Failure(USAGE, f'cannot read {path}: {error}')
  if not isinstance(config.get('devices'), dict) or not config['devices']:
    raise Failure(USAGE, f'{path} names no devices')
  return config


def device(config, name):
  name = name or config.get('default')
  if not name and len(config['devices']) == 1:
    name = next(iter(config['devices']))
  if name not in config['devices']:
    known = ', '.join(sorted(config['devices']))
    raise Failure(USAGE, f'unknown device {name!r}; configured: {known}')
  entry = dict(config['devices'][name])
  entry.setdefault('name', name)
  entry.setdefault('user', 'deck')
  return name, entry


def targets(entry):
  """Addresses to try in order: the configured one, then mDNS."""
  found = []
  if entry.get('address'):
    found.append(entry['address'])
  mdns = entry['name'] + '.local'
  if mdns not in found:
    found.append(mdns)
  for address in found:
    if not isinstance(address, str) or not re.fullmatch(
        r'[A-Za-z0-9][A-Za-z0-9._:-]*', address):
      raise Failure(USAGE, 'device addresses/names must be hostnames or IPs')
    if ':' in address:
      try:
        ipaddress.IPv6Address(address)
      except ValueError:
        raise Failure(USAGE, 'invalid device IPv6 address')
  return found


def ssh_options(entry):
  if not isinstance(entry['user'], str) or not re.fullmatch(
      r'[A-Za-z_][A-Za-z0-9_-]*', entry['user']):
    raise Failure(USAGE, 'invalid device ssh user')
  key = entry.get('key')
  key = Path(key).expanduser() if key else DEFAULT_KEY.expanduser()
  options = ['-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10']
  if key.is_file():
    options += ['-o', 'IdentitiesOnly=yes', '-i', str(key)]
  return options


def ssh(entry, script, args, timeout=None, remote=None, stdin=None):
  options = ssh_options(entry)
  if remote is None:
    remote = 'sh -s -- ' + ' '.join(shlex.quote(str(a)) for a in args)
  errors = []
  deadline = time.monotonic() + timeout if timeout is not None else None
  for address in targets(entry):
    remaining = max(0.01, deadline - time.monotonic()) if deadline else None
    try:
      proc = subprocess.run(
        ['ssh', *options, f'{entry["user"]}@{address}', remote],
        input=stdin if stdin is not None else PREAMBLE + script,
        capture_output=True, text=True,
        timeout=remaining)
    except subprocess.TimeoutExpired:
      errors.append(f'{address}: ssh timed out')
      continue
    if proc.returncode != 255:
      proc.stderr = error_text(proc.stderr)
      return proc
    if 'connected=1' in proc.stdout.splitlines():
      raise Failure(UNREACHABLE, f'the connection to {address} dropped '
                    'after the command started; its effect is unknown, so '
                    'check with `steamos lease show`')
    errors.append(f'{address}: {proc.stderr.strip()}')
  raise Failure(UNREACHABLE, 'cannot reach the device over ssh:\n  ' +
                '\n  '.join(errors))


def parse(text):
  values, legacy = {}, []
  for line in text.splitlines():
    key, sep, value = line.partition('=')
    if not sep:
      continue
    if key == 'legacy':
      legacy.append(value)
    elif key == 'legacy_info':
      values.setdefault('legacy_info', []).append(value)
    else:
      values[key] = value
  values['legacy'] = legacy
  return values


def holder(config):
  name = os.environ.get('STEAMOS_LEASE_HOLDER') or config.get('holder')
  if not name and not os.environ.get('STEAMOS_NO_AGENT_ID') and \
      shutil.which('agent-id'):
    proc = subprocess.run(['agent-id', 'show'], capture_output=True,
                          text=True, timeout=10)
    name = proc.stdout.strip() if proc.returncode == 0 else ''
  return name or f'{getpass.getuser()}@{stable_host()}'


def stable_host():
  """A host name that does not follow the network, as macOS's does."""
  if sys.platform == 'darwin' and shutil.which('scutil'):
    proc = subprocess.run(['scutil', '--get', 'LocalHostName'],
                          capture_output=True, text=True, timeout=10)
    if proc.returncode == 0 and proc.stdout.strip():
      return proc.stdout.strip()
  return socket.gethostname().split('.')[0]


def one_line(label, value):
  if '\n' in value or '\r' in value:
    raise Failure(USAGE, f'the {label} must be one line')
  return value


def iso(epoch):
  return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(int(epoch)))


def lease_summary(values):
  lease = {'state': values.get('state', 'unknown'),
           'inhibit': values.get('inhibit', 'unavailable'),
           'sleep_inhibited': {'active': True, 'inactive': False,
                              'disabled': False, 'failed': False}.get(
                                values.get('inhibit')),
           'legacy': values.get('legacy', []),
           'legacy_info': values.get('legacy_info', [])}
  for key in ('holder', 'purpose', 'start', 'expires'):
    if 'lease_' + key in values:
      lease[key] = values['lease_' + key]
  for key in ('start', 'expires'):
    if lease.get(key, '').isdigit():
      lease[key] = int(lease[key])
  return lease


def describe(name, lease):
  if lease['state'] == 'free':
    text = f'The {name} lease is free.'
  elif lease['state'] == 'broken':
    text = (f'The {name} lease lock exists without its record: it is being '
            'taken now, or was left behind and will be reclaimable after '
            'the grace period.')
  else:
    text = (f'The {name} lease is {lease["state"]}: held by '
            f'{lease.get("holder")} for "{lease.get("purpose")}" since '
            f'{iso(lease.get("start", 0))}, until '
            f'{iso(lease.get("expires", 0))}.')
  for path in lease['legacy']:
    text += (f'\nAn older project lock is present on the device: ~/{path}; '
             'remove it with that project\'s tool once it is not needed.')
  for info in lease.get('legacy_info', []):
    text += f'\n  {info.strip()}'
  text += f'\ninhibit={lease["inhibit"]}'
  return text


def number(value, label, low, high):
  if isinstance(value, bool) or not isinstance(value, (int, float)) or \
      not low < value <= high:
    raise Failure(USAGE, f'{label} must be a number above {low} and at '
                  f'most {high}')
  return value


def lease_policy(config):
  policy = config.get('lease', {})
  if not isinstance(policy, dict):
    raise Failure(USAGE, 'lease must be an object')
  if not isinstance(policy.get('prevent_sleep', True), bool):
    raise Failure(USAGE, 'prevent_sleep must be a boolean')
  number(policy.get('hours', 4), 'hours', 0, 72)
  grace = int(number(policy.get('grace_minutes', 30), 'grace_minutes', 0,
                     7 * 24 * 60))
  if grace < 1:
    raise Failure(USAGE, 'grace_minutes must be at least 1')
  legacy = policy.get('legacy_locks', [])
  if not isinstance(legacy, list) or not all(
      isinstance(p, str) and SAFE_PATH.fullmatch(p) and
      '..' not in p.split('/') for p in legacy):
    raise Failure(USAGE, 'legacy_locks must be paths inside the device '
                  'home made of letters, digits, ".", "_", "-" and "/"')
  return policy, grace, legacy


def lease_command(options):
  config = load_config()
  name, entry = device(config, options.device)
  policy, grace, legacy = lease_policy(config)
  hours = number(options.hours or policy.get('hours', 4), 'hours', 0, 72)
  who = one_line('holder', holder(config))
  purpose = one_line('purpose', getattr(options, 'purpose', '') or '')
  reason = one_line('reason', getattr(options, 'reason', '') or '')
  if options.action == 'break':
    if not reason:
      raise Failure(USAGE, 'break needs --reason')
    breakers = policy.get('breakers') or []
    if breakers and who not in breakers:
      raise Failure(REFUSED, f'{who} may not break a lease; configured '
                    f'breakers: {", ".join(breakers)}')
  proc = ssh(entry, LEASE_SCRIPT, [
    options.action, who, purpose, int(hours * 3600), grace, reason,
    str(policy.get('prevent_sleep', True)).lower(),
    *legacy])
  if proc.returncode not in (0, 1):
    raise Failure(UNREACHABLE, f'device script failed: {proc.stderr.strip()}')
  values = parse(proc.stdout)
  lease = lease_summary(values)
  result = values.get('result', 'unknown')
  if lease['inhibit'] == 'failed':
    print('Warning: sleep inhibition failed; the device may sleep.',
          file=sys.stderr)
  if options.json:
    print(json.dumps(dict(lease, result=result, device=name), indent=2))
  else:
    messages = {
      'took': f'Took the {name} lease.',
      'refreshed': f'Renewed the {name} lease.',
      'reclaimed': f'Took the {name} lease (reclaimed an expired one).',
      'released': f'Released the {name} lease.',
      'broke': f'Broke the {name} lease; the device log records why.',
      'free': f'The {name} lease is free.',
      'ok': f'The {name} lease is yours.',
      'legacy': f'An older project lock holds the {name}.',
      'busy': f'Another agent is reclaiming or breaking the {name} lease.',
      'notmine': f'The {name} lease is not yours.',
      'held': f'The {name} lease is held.',
      'expired': f'Your {name} lease has expired; renew it to keep it.',
      'gone': f'The {name} lease changed while this ran; check it again.',
      'failed': f'Could not write the {name} lease record on the device.',
    }
    stream = sys.stdout if proc.returncode == 0 else sys.stderr
    if result != 'shown':
      print(messages.get(result, result), file=stream)
    if result not in ('released', 'broke', 'free') or lease['legacy']:
      print(describe(name, lease), file=stream)
  return OK if proc.returncode == 0 else REFUSED


def devkit_pin(config):
  devkit = config.get('devkit', {})
  if not isinstance(devkit, dict):
    raise Failure(USAGE, 'devkit must be an object')
  source = devkit.get('source', DEVKIT_SOURCE)
  commit = devkit.get('commit', DEVKIT_COMMIT)
  if not isinstance(source, str) or not source or source.startswith('-'):
    raise Failure(USAGE, 'devkit source must be a repository URL')
  if not isinstance(commit, str) or not COMMIT.fullmatch(commit):
    raise Failure(USAGE, 'devkit commit must be a full 40-character '
                  'lowercase commit hash')
  return source, commit


def devkit_label(status):
  if status['devkit_utils'] != 'yes':
    return 'not installed (steamos devkit install)'
  if not status['devkit_commit']:
    return 'installed, commit unknown (not installed by steamos)'
  short = status['devkit_commit'][:7]
  if status['devkit_pinned']:
    return f'{short}, the pinned commit'
  return f'{short}, not the pinned commit (steamos devkit install)'


def devkit_cache(source, commit):
  """Valve's client/devkit-utils at COMMIT, fetched once and cached."""
  root = Path(os.environ.get('XDG_CACHE_HOME') or
              Path.home() / '.cache') / 'agent-kit' / 'steamos-devkit'
  final = root / commit
  utils = final / 'client' / 'devkit-utils'
  if (final / '.complete').is_file():
    return utils
  root.mkdir(parents=True, exist_ok=True)
  work = root / f'{commit}.tmp.{os.getpid()}'
  shutil.rmtree(work, ignore_errors=True)
  try:
    for command in (['init', '-q'],
                    ['fetch', '-q', '--depth', '1', '--', source, commit],
                    ['-c', 'advice.detachedHead=false', 'checkout', '-q',
                     'FETCH_HEAD']):
      proc = subprocess.run(['git', '-C', str(work), *command]
                            if command[0] != 'init' else
                            ['git', *command, str(work)],
                            capture_output=True, text=True)
      if proc.returncode != 0:
        raise Failure(UNREACHABLE, f'could not fetch {commit} from '
                      f'{source}: {proc.stderr.strip()}')
    head = subprocess.run(['git', '-C', str(work), 'rev-parse', 'HEAD'],
                          capture_output=True, text=True).stdout.strip()
    if head != commit:
      raise Failure(USAGE, f'fetched {head or "nothing"}, not {commit}')
    if not (work / 'client' / 'devkit-utils').is_dir():
      raise Failure(USAGE, f'{commit} has no client/devkit-utils')
    shutil.rmtree(work / '.git')
    (work / '.complete').write_text(source + '\n')
    try:
      work.rename(final)
    except OSError:
      if not (final / '.complete').is_file():
        raise
  finally:
    shutil.rmtree(work, ignore_errors=True)
  return utils


# Before copying: refuse a symlinked destination (rsync --delete would
# work inside its target) and drop the old commit record, so a copy that
# fails part way never leaves a stale claim of being pinned.
DEVKIT_PREPARE = r'''
if [ -L "$HOME/devkit-utils" ]; then echo result=symlink; exit 1; fi
rm -f -- "$HOME/devkit-utils/$1"
'''


def devkit_command(options):
  config = load_config()
  name, entry = device(config, options.device)
  source, commit = devkit_pin(config)
  # Replacing the helpers can break a title another agent is running, so
  # this needs the lease like any other change to the device.
  require_lease(config, name, entry, 'installing the helpers')
  utils = devkit_cache(source, commit)
  proc = ssh(entry, DEVKIT_PREPARE, [DEVKIT_PIN_FILE])
  if proc.returncode == 1:
    raise Failure(REFUSED, f'~/devkit-utils on {name} is a symlink; '
                  'replace it with a directory first')
  if proc.returncode != 0:
    raise Failure(UNREACHABLE, f'device script failed: '
                  f'{proc.stderr.strip()}')
  copy_directory(entry, utils, 'devkit-utils/', 'the helpers', delete=True)
  proc = ssh(entry, 'printf "%s\\n" "$1" >"$HOME/devkit-utils/$2"\n',
             [commit, DEVKIT_PIN_FILE])
  if proc.returncode != 0:
    raise Failure(UNREACHABLE, f'recording the commit failed: '
                  f'{proc.stderr.strip()}')
  print(f'Installed Valve devkit-utils {commit[:7]} on {name}.')
  return OK


def require_lease(config, name, entry, purpose):
  policy, grace, legacy = lease_policy(config)
  proc = ssh(entry, LEASE_SCRIPT,
             ['check', holder(config), '', 0, grace, '',
              str(policy.get('prevent_sleep', True)).lower(), *legacy])
  if proc.returncode != 0:
    raise Failure(REFUSED, f'{purpose} needs the {name} lease: '
                  'run `steamos lease take PURPOSE` first')


def copy_directory(entry, directory, destination, label, delete=False):
  """Share ssh options and address fallback for helper and title copies."""
  if not re.fullmatch(r'[A-Za-z0-9._/-]+', destination):
    raise Failure(REFUSED, 'unsafe remote path for rsync')
  if not shutil.which('rsync'):
    raise Failure(USAGE, f'rsync is needed to copy {label}')
  remote_shell = ' '.join(shlex.quote(o) for o in ['ssh', *ssh_options(entry)])
  errors = []
  for address in targets(entry):
    proc = subprocess.run(
      ['rsync', '-a', *(['--delete'] if delete else []), '-e', remote_shell,
       '--', f'{directory}/',
       f'{entry["user"]}@{address}:{destination}'],
      capture_output=True, text=True)
    if proc.returncode == 0:
      break
    errors.append(f'{address}: {proc.stderr.strip()}')
    if proc.returncode != 255:
      raise Failure(UNREACHABLE, f'copying {label} failed:\n  ' +
                    '\n  '.join(errors))
  else:
    raise Failure(UNREACHABLE, 'cannot reach the device over ssh:\n  ' +
                  '\n  '.join(errors))


def last_json(proc, label, kind=dict):
  """Valve helpers may print progress before their final JSON reply."""
  if proc.returncode != 0:
    detail = ' '.join(part for part in (
      error_text(proc.stderr), error_text(proc.stdout)) if part)
    raise Failure(REFUSED, f'{label} failed: {detail}')
  try:
    reply = json.loads(proc.stdout.strip().splitlines()[-1])
  except (ValueError, IndexError):
    raise Failure(UNREACHABLE, f'{label} returned no valid JSON reply')
  if not isinstance(reply, kind):
    raise Failure(UNREACHABLE, f'{label} returned an unexpected JSON type')
  if isinstance(reply, dict) and 'error' in reply:
    raise Failure(REFUSED, f'{label}: {reply["error"]}')
  return reply


def helper(entry, script, args):
  # Valve's RPC exits -1 (255) for Steam errors; normalize that so ssh
  # does not mistake an application refusal for a dropped connection.
  return ssh(entry, 'tool=$1; shift\n'
             'if python3 "$HOME/devkit-utils/$tool" "$@"; then exit 0\n'
             'else exit 1; fi\n', [script, *args])


TITLE_INVENTORY = r'''
python3 - <<'PY'
import json, re
from pathlib import Path
root = Path.home() / 'devkit-game'
invalid = []
if root.is_dir():
  for folder in root.iterdir():
    if folder.is_dir() and not re.fullmatch(r'[A-Za-z0-9]+', folder.name):
      if any((root / (folder.name + '-' + suffix + '.json')).is_file()
             for suffix in ('argv', 'settings')):
        invalid.append(folder.name)
print(json.dumps({'root': str(root), 'invalid_leftovers': sorted(invalid)}))
PY
'''

TITLE_PREPARE = r'''
if [ -L "$HOME/devkit-game" ] || [ -L "$HOME/devkit-game/$1" ]; then
  echo 'title destination is a symlink' >&2; exit 1
fi
if python3 "$HOME/devkit-utils/steamos-prepare-upload" --gameid "$1"; then
  exit 0
else exit 1; fi
'''

TITLE_LAUNCH = r'''
pid=$(cat "$HOME/.steam/steam.pid" 2>/dev/null)
case $pid in
  ''|*[!0-9]*|0) echo 'Steam must be running in Game Mode' >&2; exit 1 ;;
esac
if ! kill -0 "$pid" 2>/dev/null; then
  echo 'Steam must be running in Game Mode' >&2; exit 1
fi
now=$(date +%s)
echo "device_time=$now"
if [ -L "$HOME/.agent-kit-steamos-launches" ] ||
   ! printf '%s\t%s\t%s\n' "$now" "$1" "$2" \
     >>"$HOME/.agent-kit-steamos-launches"; then
  echo 'cannot record the launch window' >&2; exit 1
fi
if python3 "$HOME/devkit-utils/steam-devkit-rpc" run-game "gameid=$1"; then
  exit 0
else exit 1; fi
'''

TITLE_REMOVE = r'''
if [ -L "$HOME/devkit-game" ] || [ -L "$HOME/devkit-game/$1" ]; then
  echo 'title destination is a symlink' >&2; exit 1
fi
status=0
python3 "$HOME/devkit-utils/steamos-delete" --delete-title "$1" || status=$?
rm -f -- "$HOME/devkit-game/$1-argv.json" "$HOME/devkit-game/$1-env.json" \
  "$HOME/devkit-game/$1-settings.json" || exit 1
echo configs_removed=1
if [ "$status" -ne 0 ]; then exit 1; fi
'''


def title_command(options):
  gameid = getattr(options, 'name', None)
  if gameid is not None and not TITLE_NAME.fullmatch(gameid):
    raise Failure(USAGE, 'title NAME must contain only letters and digits')
  if options.action == 'register':
    directory = Path(options.directory).expanduser().resolve()
    start = Path(options.start)
    if not directory.is_dir() or start.is_absolute() or \
        '..' in start.parts or not (directory / start).is_file() or \
        directory not in (directory / start).resolve().parents:
      raise Failure(USAGE, '--start must name a file inside DIR')
  config = load_config()
  if options.action == 'launch':
    identity = one_line('holder', holder(config))
    if '\0' in identity:
      raise Failure(USAGE, 'the holder must not contain NUL')
  name, entry = device(config, options.device)
  if options.action != 'list':
    require_lease(config, name, entry, f'title {options.action}')
  _, commit = devkit_pin(config)
  proc = ssh(entry, STATUS_SCRIPT, [])
  if proc.returncode != 0:
    raise Failure(UNREACHABLE, f'device status failed: {proc.stderr.strip()}')
  facts = parse(proc.stdout)
  if facts.get('devkit_commit') != commit:
    raise Failure(REFUSED, 'the device needs pinned devkit-utils; '
                  'run `steamos devkit install`')
  if options.action in ('list', 'register', 'remove'):
    inventory = last_json(ssh(entry, TITLE_INVENTORY, []), 'title inventory')
  if options.action == 'list':
    games = last_json(helper(entry, 'steamos-list-games', []), 'title list',
                      list)
    result = {'device': name, 'games': games,
              'invalid_leftovers': inventory['invalid_leftovers']}
    if options.json:
      print(json.dumps(result, indent=2))
    else:
      print(json.dumps(games, indent=2))
      for invalid in result['invalid_leftovers']:
        print(f'Invalid leftover: {invalid!r} (blocks Steam re-sync)')
    return OK
  if options.action in ('register', 'remove'):
    if inventory['invalid_leftovers']:
      invalid = ', '.join(repr(n) for n in inventory['invalid_leftovers'])
      raise Failure(REFUSED, f'invalid title leftovers block Steam re-sync: '
                    f'{invalid}; inspect with `steamos title list`')
  if options.action == 'register':
    require_lease(config, name, entry, 'preparing the title')
    prepared = last_json(ssh(entry, TITLE_PREPARE, [gameid]), 'title prepare')
    destination = str(Path(inventory['root']) / gameid)
    if not isinstance(prepared, dict) or \
        prepared.get('directory') != destination:
      raise Failure(REFUSED, 'title prepare returned an unexpected directory')
    require_lease(config, name, entry, 'copying the title')
    copy_directory(entry, directory, destination + '/', 'the title',
                   delete=True)
    # Valve's helper reads compat_tool unconditionally; an empty string is
    # what its own GUI sends for no runtime.
    settings = {'steam_play': '0', 'compat_tool': (
      'SteamLinuxRuntime_4' if options.runtime == 'slr4' else '')}
    parms = {'gameid': gameid, 'directory': destination,
             'argv': [options.start, *options.arg], 'env': {},
             'settings': settings, 'clear_settings': True,
             'force_appid': None, 'lepton_args': ''}
    require_lease(config, name, entry, 'registering the title')
    reply = last_json(helper(entry, 'steam-client-create-shortcut',
                             ['--parms', json.dumps(parms)]), 'title register')
    if 'success' not in reply:
      raise Failure(UNREACHABLE, 'title register returned no success result')
    result = {'device': name, 'gameid': gameid, 'reply': reply}
    text = f'Registered {gameid} on {name}.'
    code = OK
  elif options.action == 'launch':
    proc = ssh(entry, TITLE_LAUNCH, [gameid, identity])
    epoch = parse(proc.stdout).get('device_time')
    if not epoch or not epoch.isdigit():
      raise Failure(REFUSED, proc.stderr.strip() or
                    'Steam must be running in Game Mode')
    result = {'device': name, 'gameid': gameid, 'device_time': int(epoch),
              'launched': proc.returncode == 0,
              'output': remote_output(proc), 'stderr': proc.stderr.strip()}
    code = OK if proc.returncode == 0 else REFUSED
    text = (f'{gameid} on {name}: device time {epoch}; '
            f'launch {"succeeded" if code == OK else "failed"}.')
  else:
    proc = ssh(entry, TITLE_REMOVE, [gameid])
    if parse(proc.stdout).get('configs_removed') != '1':
      raise Failure(REFUSED, f'title remove failed: {proc.stderr.strip()}')
    synced = proc.returncode == 0 and \
      'Steam client sync of devkit games failed' not in (
        proc.stdout + proc.stderr)
    result = {'device': name, 'gameid': gameid, 'removed': True,
              'steam_sync': synced, 'output': remote_output(proc),
              'stderr': proc.stderr.strip()}
    code = OK if synced else REFUSED
    text = (f'Removed {gameid} on {name}; Steam re-sync '
            f'{"succeeded" if synced else "failed"}.')
  print(json.dumps(result, indent=2) if options.json else text)
  return code


def remote_output(proc):
  return '\n'.join(line for line in proc.stdout.splitlines()
                   if line not in ('connected=1', 'configs_removed=1') and
                   not line.startswith('device_time='))


def project(options, optional=False):
  try:
    return publication.project_config(getattr(options, 'project', None),
                                      optional=optional)
  except (OSError, ValueError) as error:
    raise Failure(USAGE, f'project configuration: {error}')


def local_stage(root, config):
  try:
    bundle = publication.no_links(root, config['bundle'])
    manifest = publication.verify(bundle, config['inventory'], config['start'])
  except (OSError, ValueError) as error:
    raise Failure(REFUSED, f'stage verification: {error}')
  return bundle, manifest, publication.version_id(manifest)


def stage_command(options):
  root, config = project(options)
  _, _, version = local_stage(root, config)
  result = {'title': config['title'], 'version': version}
  print(json.dumps(result, indent=2) if options.json else version)
  return OK


def project_remote(entry, request, action):
  # Use exactly the local verifier on the device, without installing a
  # project script or inferring a private format. Length-frame its source
  # and then send the request on stdin; neither becomes a large argv item.
  source = Path(publication.__file__).read_text()
  loader = ('import sys; n=int(sys.stdin.buffer.readline()); '
            'exec(compile(sys.stdin.buffer.read(n), "<steamos-deploy>", '
            '"exec"))')
  payload = (str(len(source.encode('utf-8'))) + '\n' + source +
             json.dumps(dict(request, action=action)))
  proc = ssh(entry, '', [], remote='echo connected=1; python3 -c ' +
             shlex.quote(loader) + ' ' + shlex.quote(action),
             stdin=payload)
  return last_json(proc, 'project ' + action)


def register_project(config, name, entry, project_config, destination, start):
  require_lease(config, name, entry, 'registering the project')
  settings = {'steam_play': '0', 'compat_tool': (
    'SteamLinuxRuntime_4' if project_config['runtime'] == 'slr4' else '')}
  parms = {'gameid': project_config['title'], 'directory': destination,
           'argv': ['./current/' + start, *project_config['args']], 'env': {},
           'settings': settings, 'clear_settings': True,
           'force_appid': None, 'lepton_args': ''}
  reply = last_json(helper(entry, 'steam-client-create-shortcut',
                           ['--parms', json.dumps(parms)]), 'title register')
  # Valve's helper reports success as {"success": ""} and failure as
  # {"error": ...}, both with exit status 0.
  if 'error' in reply:
    raise Failure(REFUSED, f'title register failed: {reply["error"]}')
  if 'success' not in reply:
    raise Failure(UNREACHABLE, 'title register returned no success result')
  if reply['success'] is False:
    raise Failure(REFUSED, 'title register reported failure')
  return reply


def deploy_command(options):
  import uuid
  root, project_config = project(options)
  config = load_config()
  name, entry = device(config, options.device)
  request = {'config': project_config}
  if options.list:
    result = project_remote(entry, request, 'list')
  else:
    bundle = manifest = version = None
    if not options.rollback and not options.abort_stale:
      bundle, manifest, version = local_stage(root, project_config)
    require_lease(config, name, entry, 'deploy')
    _, commit = devkit_pin(config)
    facts = ssh(entry, STATUS_SCRIPT, [])
    if facts.returncode != 0:
      raise Failure(UNREACHABLE, 'device status failed: ' + facts.stderr.strip())
    if parse(facts.stdout).get('devkit_commit') != commit:
      raise Failure(REFUSED, 'the device needs pinned devkit-utils; '
                    'run `steamos devkit install`')
    if options.abort_stale:
      _, _, legacy = lease_policy(config)
      request.update(holder=holder(config), pin=commit, legacy=legacy)
      result = project_remote(entry, request, 'abort_stale')
      result.update(device=name, title=project_config['title'])
      print(json.dumps(result, indent=2) if options.json else
            f'{name}: removed stale lock and '
            f'{len(result["removed_partials"])} partial directories')
      return OK
    inventory = last_json(ssh(entry, TITLE_INVENTORY, []), 'title inventory')
    if inventory['invalid_leftovers']:
      raise Failure(REFUSED, 'invalid title leftovers block Steam re-sync: ' +
                    ', '.join(repr(n) for n in inventory['invalid_leftovers']))
    gameid = project_config['title']
    require_lease(config, name, entry, 'preparing the project title')
    prepared = last_json(ssh(entry, TITLE_PREPARE, [gameid]), 'title prepare')
    destination = str(Path(inventory['root']) / gameid)
    if prepared.get('directory') != destination:
      raise Failure(REFUSED, 'title prepare returned an unexpected directory')
    _, _, legacy = lease_policy(config)
    request.update(holder=holder(config), pin=commit, legacy=legacy,
                   token=uuid.uuid4().hex, rollback=options.rollback)
    if version is not None:
      request.update(version=version, manifest=manifest)
    # A successful prepare owns a lock and (when needed) one partial.
    # Failed prepare never adopts a pre-existing lock or partial.
    acquired = False
    attempted = False
    previous = {}

    def interrupted(signum, _frame):
      raise Failure(REFUSED, f'deployment interrupted by signal {signum}')

    try:
      for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        previous[signum] = signal.signal(signum, interrupted)
      attempted = True
      state = project_remote(entry, request, 'prepare')
      acquired = True
      if options.rollback:
        request.update(version=state['version'], inventory=state['inventory'],
                       start=state['start'])
      else:
        request.update(inventory=project_config['inventory'],
                       start=project_config['start'])
        if not state['skipped_copy']:
          require_lease(config, name, entry, 'copying the project')
          partial = destination + '/versions/' + version + '.partial/'
          copy_directory(entry, bundle, partial, 'the project bundle',
                         delete=True)
          project_remote(entry, request, 'finish_copy')
      result = project_remote(entry, request, 'switch')
      # Do not alter the existing shortcut until publication succeeds. A
      # changed start/args/runtime must not break the previous deployment
      # when the switch is refused (for example after lease expiry).
      try:
        reply = register_project(config, name, entry, project_config,
                                 destination, request['start'])
      except Failure as error:
        raise Failure(error.code, f'published version {request["version"]}; '
                      f'shortcut registration failed: {error}; inspect '
                      '`steamos deploy --list` before retrying or rollback')
      result.update(rollback=options.rollback, reply=reply,
                    skipped_copy=state.get('skipped_copy', False))
    finally:
      # Cleanup is token-authorized even if the lease expires. Preserve the
      # primary error if the connection also prevents bounded cleanup.
      for signum in previous:
        signal.signal(signum, signal.SIG_IGN)
      if attempted:
        try:
          project_remote(entry, request, 'abort')
        except Failure as error:
          if acquired or error.code == UNREACHABLE:
            print('steamos: cleanup unconfirmed; inspect the partial/lock: '
                  + str(error), file=sys.stderr)
      for signum, handler in previous.items():
        signal.signal(signum, handler)
  result.update(device=name, title=project_config['title'])
  if 'warnings' in result:
    result['warnings'] = [error_text(w) for w in result['warnings']]
  for warning in result.get('warnings', []):
    print('steamos: published, retention warning: ' + warning, file=sys.stderr)
  print(json.dumps(result, indent=2) if options.json else
        f'{project_config["title"]} on {name}: current '
        f'{result["current"] or "none"}; versions '
        f'{", ".join(result["versions"]) or "none"}; running '
        f'{json.dumps(result["running"])}')
  return OK


def wake_command(options):
  config = load_config()
  name, entry = device(config, options.device)
  mac = entry.get('mac', '')
  if not isinstance(mac, str) or not re.fullmatch(
      r'[0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){5}', mac):
    raise Failure(USAGE, 'wake needs a configured mac (XX:XX:XX:XX:XX:XX)')
  broadcast = entry.get('broadcast', '255.255.255.255')
  try:
    broadcast = str(ipaddress.IPv4Address(broadcast))
  except (ValueError, TypeError):
    raise Failure(USAGE, 'broadcast must be an IPv4 address')
  if not 0 <= options.wait <= 3600:
    raise Failure(USAGE, '--wait must be between 0 and 3600 seconds')
  packet = b'\xff' * 6 + bytes.fromhex(mac.replace(':', '')) * 16
  try:
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
      sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
      for attempt in range(3):
        if attempt:
          time.sleep(0.1)
        sock.sendto(packet, (broadcast, 9))
  except OSError as error:
    raise Failure(UNREACHABLE, f'could not send wake packet: {error}')
  deadline = time.monotonic() + options.wait
  awake = False
  while True:
    try:
      remaining = max(0.1, deadline - time.monotonic())
      proc = ssh(entry, 'echo awake=1\n', [], timeout=min(2, remaining))
      awake = proc.returncode == 0 and parse(proc.stdout).get('awake') == '1'
    except Failure as failure:
      if failure.code != UNREACHABLE:
        raise
    if awake or time.monotonic() >= deadline:
      break
    time.sleep(min(1, max(0, deadline - time.monotonic())))
  result = {'device': name, 'awake': awake, 'broadcast': broadcast}
  print(json.dumps(result, indent=2) if options.json else
        f'Sent wake packet to {name}; '
        f'{"ssh is answering" if awake else "ssh did not answer"}.')
  return OK if awake else UNREACHABLE


def status_command(options):
  selected_project = project(options, optional=True)
  config = load_config()
  name, entry = device(config, options.device)
  policy, grace, legacy = lease_policy(config)
  script = STATUS_SCRIPT + LEASE_SCRIPT
  proc = ssh(entry, script, ['show', '', '', 0, grace, '',
                           str(policy.get('prevent_sleep', True)).lower(),
                           *legacy])
  if proc.returncode != 0:
    raise Failure(UNREACHABLE, f'device script failed: {proc.stderr.strip()}')
  values = parse(proc.stdout)
  status = {'device': name}
  for key in ('os_name', 'os_version', 'os_build', 'os_variant', 'channel',
              'model', 'hostname', 'devkit_utils', 'devkit_commit',
              'battery_status'):
    status[key] = values.get(key, '')
  try:
    pinned = devkit_pin(config)[1]
  except Failure:
    pinned = None
  status['devkit_pinned'] = status['devkit_commit'] == pinned
  for key in ('free_bytes', 'uptime_seconds', 'battery_percent'):
    status[key] = int(values[key]) if values.get(key, '').isdigit() else None
  status['external_power'] = values.get('external_power') == 'yes'
  status['lease'] = lease_summary(values)
  if selected_project is not None:
    root, project_config = selected_project
    deployed = project_remote(entry, {'config': project_config}, 'list')
    deployed['title'] = project_config['title']
    try:
      deployed['local_version'] = local_stage(root, project_config)[2]
    except Failure as error:
      deployed.update(local_version=None, stage_error=str(error))
    status['project'] = deployed
  if options.json:
    print(json.dumps(status, indent=2))
    return OK
  free = status['free_bytes']
  if status['battery_percent'] is None:
    power = 'mains (no battery reported)'
  else:
    power = 'external power' if status['external_power'] else 'battery'
    power += f', battery {status["battery_percent"]}%'
  rows = [
    ('Device', f'{name} ({status["hostname"]}, {status["model"]})'),
    ('SteamOS', f'{status["os_version"] or "unknown"} build '
                f'{status["os_build"] or "unknown"}, '
                f'channel {status["channel"] or "unknown"}'),
    ('Free space', f'{free / 2**30:.1f} GiB' if free else 'unknown'),
    ('Power', power),
    ('devkit-utils', devkit_label(status)),
  ]
  for label, value in rows:
    print(f'{label:<13} {value}')
  print(describe(name, status['lease']))
  if 'project' in status:
    deployed = status['project']
    print(f'{deployed["title"]}: current={deployed["current"] or "none"} '
          f'local={deployed["local_version"] or "unverified"}')
    if 'stage_error' in deployed:
      print(deployed['stage_error'])
  return OK


# Read logs using the device clock and timezone. NAME selects a launch
# window, not a journal filter: Steam combines output from several titles.
LOGS_SCRIPT = r'''
python3 - "$@" <<'PY'
import json, re, subprocess, sys, time
from collections import deque
from pathlib import Path
name, since, until, limit = sys.argv[1:]
try:
  if not since:
    ledger = Path.home() / '.agent-kit-steamos-launches'
    if ledger.is_file():
      for line in ledger.read_text(errors='replace').splitlines():
        fields = line.split(None, 2)
        if len(fields) != 3 or not fields[0].isascii() or \
            not fields[0].isdigit() or \
            not re.fullmatch(r'[A-Za-z0-9]+', fields[1]):
          continue
        if (not name or fields[1] == name) and \
            0 <= int(fields[0]) <= 253402300799:
          since = fields[0]
    if not since:
      raise ValueError('no recorded launch; supply --since EPOCH')
  since, until = int(since), int(until) if until else int(time.time())
  if since > until:
    raise ValueError('launch window starts after --until or device now')
  try:
    proc = subprocess.run(
      ['journalctl', '--user', '--since', '@' + str(since), '--until',
       '@' + str(until), '-o', 'short-iso', '--no-pager'],
      capture_output=True, text=True, errors='replace', timeout=30)
  except FileNotFoundError:
    proc = None
  source = 'journalctl'
  if proc is not None and proc.returncode == 0:
    lines = proc.stdout.splitlines()
  else:
    source = 'console-linux.txt'
    path = Path.home() / '.local/share/Steam/logs/console-linux.txt'
    lines = deque(maxlen=int(limit))
    in_window = False
    with path.open(errors='replace') as stream:
      for line in stream:
        match = re.match(r'^\[(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)\]', line)
        if match:
          try:
            epoch = time.mktime(time.strptime(match[1], '%Y-%m-%d %H:%M:%S'))
            in_window = since <= epoch <= until
          except (ValueError, OverflowError):
            in_window = False
        if in_window:
          lines.append(line.rstrip('\n'))
  print(json.dumps({'source': source, 'since': since, 'until': until,
                    'lines': list(lines)[-int(limit):]}))
except (OSError, ValueError, subprocess.TimeoutExpired) as error:
  print(str(error), file=sys.stderr)
  sys.exit(1)
PY
'''


def logs_command(options):
  if options.name is not None and not TITLE_NAME.fullmatch(options.name):
    raise Failure(USAGE, 'title NAME must contain only letters and digits')
  for value in (options.since, options.until):
    if value is not None and not 0 <= value <= 253402300799:
      raise Failure(USAGE, 'epochs must be between 0 and 253402300799')
  if options.since is not None and options.until is not None and \
      options.since > options.until:
    raise Failure(USAGE, '--since must not be after --until')
  if not 1 <= options.lines <= 1000000:
    raise Failure(USAGE, '--lines must be between 1 and 1000000')
  _, entry = device(load_config(), options.device)
  result = last_json(ssh(entry, LOGS_SCRIPT, [
    options.name or '', '' if options.since is None else options.since,
    '' if options.until is None else options.until, options.lines]), 'logs')
  if options.json:
    print(json.dumps(result, indent=2))
  else:
    for line in result['lines']:
      print(line)
  return OK


# Valve requests mode 1 (baseplane) and discovers a gamescope-named PNG
# in /tmp. Preserve existing captures; claim only a newly created file.
# A small mutex serializes our requests, independently of the device lease.
CAPTURE_SCRIPT = r'''
python3 - <<'PY'
import json, os, shutil, signal, subprocess, sys, tempfile, time
from pathlib import Path
root = Path('/tmp')
lock = Path.home() / '.agent-kit-steamos-capture'
folder = None
owned = None
ready = False
def interrupted(signum, frame):
  raise SystemExit(128 + signum)
for signum in (signal.SIGHUP, signal.SIGTERM):
  signal.signal(signum, interrupted)
def identity(path):
  stat = path.stat()
  return stat.st_dev, stat.st_ino
def stale():
  stamp = lock.stat().st_mtime
  try:
    owner = json.loads((lock / 'owner').read_text())
    pid, recorded_time = owner['pid'], owner['time']
    if not isinstance(pid, int) or pid <= 0 or \
        not isinstance(recorded_time, (int, float)):
      raise ValueError('invalid capture owner')
    stamp = recorded_time
    try:
      os.kill(pid, 0)
    except ProcessLookupError:
      return True
    except PermissionError:
      pass
  except (OSError, ValueError, KeyError, TypeError):
    pass
  return time.time() - stamp > 60
try:
  if not shutil.which('pgrep') or subprocess.run(
      ['pgrep', '-x', 'gamescope|gamescope-wl'],
      stdout=subprocess.DEVNULL).returncode:
    raise ValueError('gamescope is not running; capture needs Game Mode')
  if not shutil.which('xprop'):
    raise ValueError('xprop is unavailable; capture needs Game Mode')
  try:
    lock.mkdir()
  except FileExistsError:
    previous = identity(lock)
    if not stale():
      raise ValueError('another capture is active')
    aside = lock.with_name(lock.name + '.stale.' + str(os.getpid()))
    lock.rename(aside)
    if identity(aside) != previous:
      if not lock.exists():
        aside.rename(lock)
      raise ValueError('capture lock changed; retry capture')
    (aside / 'owner').unlink(missing_ok=True)
    aside.rmdir()
    lock.mkdir()
  owned = identity(lock)
  (lock / 'owner').write_text(json.dumps(
    {'pid': os.getpid(), 'time': time.time()}))
  before = set(root.glob('gamescope*.png'))
  folder = Path(tempfile.mkdtemp(prefix='steamos-capture-', dir=str(root)))
  proc = subprocess.run(
    ['xprop', '-root', '-f', 'GAMESCOPECTRL_DEBUG_REQUEST_SCREENSHOT', '32c',
     '-set', 'GAMESCOPECTRL_DEBUG_REQUEST_SCREENSHOT', '1'],
    env=dict(os.environ, DISPLAY=':0'), capture_output=True, text=True,
    timeout=5)
  if proc.returncode:
    raise ValueError('gamescope screenshot request failed: ' + proc.stderr)
  deadline = time.monotonic() + 10
  while time.monotonic() < deadline:
    for path in sorted(set(root.glob('gamescope*.png')) - before):
      if path.is_symlink() or not path.is_file():
        continue
      try:
        # Do not copy an asynchronous, partially written PNG.
        with path.open('rb') as stream:
          signature = stream.read(8)
          stream.seek(-12, 2)
          end = stream.read()
        if signature != b'\x89PNG\r\n\x1a\n' or \
            end != b'\x00\x00\x00\x00IEND\xaeB`\x82':
          continue
        destination = folder / 'capture.png'
        path.rename(destination)
      except (OSError, ValueError):
        continue
      print(json.dumps({'path': str(destination)}))
      ready = True
      break
    if ready:
      break
    time.sleep(.1)
  if not ready:
    raise ValueError('gamescope screenshot timed out after 10 seconds')
except (OSError, ValueError, subprocess.TimeoutExpired) as error:
  print(str(error), file=sys.stderr)
  sys.exit(1)
finally:
  try:
    if folder is not None and not ready:
      (folder / 'capture.png').unlink(missing_ok=True)
      folder.rmdir()
  finally:
    if owned is not None and lock.exists() and identity(lock) == owned:
      (lock / 'owner').unlink(missing_ok=True)
      lock.rmdir()
PY
'''

CAPTURE_PATH = re.compile(r'/tmp/steamos-capture-[A-Za-z0-9_-]+/capture\.png')
CSV_NAME = re.compile(r'mangoapp_[A-Za-z0-9._-]+\.csv')


def pull_file(entry, remote, output):
  """Download a validated absolute path with shared ssh options/fallback."""
  if not re.fullmatch(r'/[A-Za-z0-9._/-]+', remote) or \
      '..' in Path(remote).parts:
    raise Failure(REFUSED, 'unsafe remote path for scp')
  if not shutil.which('scp'):
    raise Failure(USAGE, 'scp is needed to download device files')
  errors = []
  temporary = None
  try:
    with tempfile.NamedTemporaryFile(dir=output.parent,
                                     prefix='.steamos-download-',
                                     delete=False) as stream:
      temporary = Path(stream.name)
    for address in targets(entry):
      # Bracket IPv6 addresses in scp's host:path syntax.
      address_arg = f'[{address}]' if ':' in address else address
      proc = subprocess.run(
        ['scp', *ssh_options(entry), '--',
         f'{entry["user"]}@{address_arg}:{remote}', str(temporary)],
        capture_output=True, text=True)
      if proc.returncode == 0:
        temporary.replace(output)
        return
      errors.append(f'{address}: {proc.stderr.strip()}')
      if proc.returncode != 255:
        break
  except OSError as error:
    raise Failure(USAGE, f'cannot write --out: {error}')
  finally:
    if temporary is not None:
      temporary.unlink(missing_ok=True)
  raise Failure(UNREACHABLE, 'downloading device file failed:\n  ' +
                '\n  '.join(errors))


def output_path(value):
  if '\0' in value:
    raise Failure(USAGE, '--out must not contain NUL')
  return Path(value).expanduser().resolve()


def capture_command(options):
  name, entry = device(load_config(), options.device)
  safe_name = re.sub(r'[^A-Za-z0-9._-]', '_', str(name))
  timestamp = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())
  filename = f'steamos-capture-{safe_name}-{timestamp}.png'
  output = output_path(options.out or os.path.join(os.getcwd(), filename))
  if not output.parent.is_dir() or output.is_dir():
    raise Failure(USAGE, '--out must name a file in an existing directory')
  reply = last_json(ssh(entry, CAPTURE_SCRIPT, []), 'capture')
  remote = reply.get('path')
  if not isinstance(remote, str) or not CAPTURE_PATH.fullmatch(remote):
    raise Failure(UNREACHABLE, 'capture returned an unsafe temporary path')
  download_failed = False
  try:
    pull_file(entry, remote, output)
  except Failure:
    download_failed = True
    raise
  finally:
    try:
      cleanup = ssh(entry, 'rm -f -- "$1" && rmdir -- "${1%/*}"\n', [remote])
      if cleanup.returncode:
        raise Failure(REFUSED, 'could not remove the device capture temp file: '
                      + cleanup.stderr.strip())
    except Failure as error:
      if download_failed:
        print('Warning: capture cleanup failed: ' + error_text(error),
              file=sys.stderr)
      else:
        raise
  if options.json:
    print(json.dumps({'device': name, 'output': str(output)}, indent=2))
  else:
    print(f'Screenshot saved to {output}')
  return OK


FRAMETIMES_FILES = r'''
python3 - <<'PY'
import json, re
from pathlib import Path
sessions = {}
for path in Path.home().glob('mangoapp_*.csv'):
  if path.is_symlink() or not path.is_file() or not re.fullmatch(
      r'mangoapp_[A-Za-z0-9._-]+\.csv', path.name):
    continue
  session = path.name[:-4]
  if session.endswith('_summary'):
    session = session[:-8]
  sessions.setdefault(session, []).append((path.stat().st_mtime_ns, path))
# Summary is normally written last. Select the newest session by either
# member's mtime, then return all its members regardless of their mtimes.
latest = max(sessions, key=lambda session: (
    max(stamp for stamp, _ in sessions[session]), session), default=None)
files = sorted(str(path) for _, path in sessions.get(latest, []))
print(json.dumps({'files': files}))
PY
'''


def frametimes_command(options):
  config = load_config()
  name, entry = device(config, options.device)
  if options.action != 'pull':
    require_lease(config, name, entry, f'frametimes {options.action}')
    proc = ssh(entry, 'if mangohudctl set log_session "$1"; then exit 0\n'
               'else exit 1; fi\n',
               ['true' if options.action == 'start' else 'false'])
    if proc.returncode:
      raise Failure(REFUSED, 'MangoHud logging control failed: ' +
                    proc.stderr.strip())
    result = {'device': name, 'logging': options.action == 'start'}
    text = f'MangoHud logging {options.action} on {name}.'
  else:
    output = output_path(options.out or os.getcwd())
    if output.exists() and not output.is_dir():
      raise Failure(USAGE, '--out must name a directory')
    reply = last_json(ssh(entry, FRAMETIMES_FILES, []), 'frametimes inventory')
    files = reply.get('files')
    if not isinstance(files, list) or any(
        not isinstance(path, str) or not CSV_NAME.fullmatch(Path(path).name)
        or not re.fullmatch(r'/[A-Za-z0-9._/-]+', path)
        or '..' in Path(path).parts for path in files):
      raise Failure(UNREACHABLE, 'frametimes returned unsafe CSV paths')
    if not files:
      raise Failure(REFUSED, 'no MangoHud CSV logs in the device home; '
                    'start and stop a logging session first')
    if not any(not Path(path).stem.endswith('_summary') for path in files):
      raise Failure(REFUSED, 'newest MangoHud session is missing its base CSV')
    if not options.partial and not any(
        Path(path).stem.endswith('_summary') for path in files):
      raise Failure(REFUSED, 'logging may still be active; run frametimes stop '
                    'before pulling, or use --partial')
    try:
      output.mkdir(parents=True, exist_ok=True)
    except OSError as error:
      raise Failure(USAGE, f'cannot create --out directory: {error}')
    for remote in files:
      pull_file(entry, remote, output / Path(remote).name)
    result = {'device': name,
              'files': [str(output / Path(path).name) for path in files]}
    text = '\n'.join(result['files'])
  print(json.dumps(result, indent=2) if options.json else text)
  return OK


# The ssh command is constant Python source. COMMAND and all its arguments
# arrive as JSON over stdin, followed by heartbeats. EOF, missed heartbeats
# or device HUP/INT/TERM cancel the command process group before restoration.
# No governor change depends on the host reconnecting to undo it.
BENCH_SCRIPT = 'power_script = ' + repr(POWER_SCRIPT) + '\n' + r'''
import csv
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import uuid

print('connected=1', flush=True)
request = json.loads(sys.stdin.readline())
home = Path.home().resolve()
sysfs = Path('/sys')
# Private fixture override; never forwarded from the host or used by the
# installed privileged helper. Tests must put their sysfs beneath HOME.
if os.environ.get('STEAMOS_TEST_SYSFS'):
  sysfs = Path(os.environ['STEAMOS_TEST_SYSFS']).resolve()
  if home not in sysfs.parents or sysfs.name != '.steamos-test-sysfs':
    sys.exit('invalid test sysfs: expected HOME/.steamos-test-sysfs')
root = home / '.agent-kit-steamos-bench'
if root.is_symlink():
  sys.exit('bench root must not be a symlink')
root.mkdir(mode=0o700, exist_ok=True)
directory = None
helper = request['governor_helper']
cancel = threading.Event()
interruption = 0
last_heartbeat = time.monotonic()
child = None
modified = False
before = during = after = {}
power_before = power_after = {}
status = None
error = ''
started = time.time()
ended = None
perf = bool(request['perf_stat'] and shutil.which('perf'))

def interrupted(signum, frame):
  global interruption
  interruption = signum
  cancel.set()

for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
  signal.signal(signum, interrupted)

def heartbeats():
  global last_heartbeat
  for line in sys.stdin:
    last_heartbeat = time.monotonic()
  cancel.set()

threading.Thread(target=heartbeats, daemon=True).start()

def save(name, value):
  (directory / name).write_text(json.dumps(value, indent=2) + '\n')

def governors():
  result = {}
  for path in sorted(sysfs.glob(
      'devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor')):
    cpu = path.parent.parent.name
    value = path.read_text().strip()
    if not re.fullmatch(r'cpu[0-9]+', cpu) or not re.fullmatch(
        r'[A-Za-z0-9_-]+', value):
      raise RuntimeError('cannot read valid per-CPU governors')
    result[cpu] = value
  return result

def power():
  proc = subprocess.run(['sh', '-c', power_script],
                        capture_output=True, text=True)
  fields = dict(line.split('=', 1) for line in proc.stdout.splitlines()
                if '=' in line)
  percent = fields.get('battery_percent', '')
  return {'external_power': fields.get('external_power') == 'yes',
          'battery_percent': int(percent) if percent.isdigit() else None,
          'battery_status': fields.get('battery_status', '')}

def set_governor(cpu, value):
  command = ['sudo', '-n', helper, cpu, value]
  try:
    proc = subprocess.run(command, capture_output=True, text=True,
                          timeout=10)
    if proc.returncode == 0:
      return
    detail = proc.stderr.strip()
  except (OSError, subprocess.TimeoutExpired) as exc:
    detail = str(exc)
  raise RuntimeError('sudo -n refused or helper failed: ' +
                     ' '.join(command) + '; ' + detail +
                     '. See bin/steamos.md, optional governor sudoers '
                     'helper. Pinning requires permission for each CPU '
                     'and its saved governor as well as performance.')

def stop_command():
  if child is None:
    return
  # The group belongs to the Popen we just created, never a saved PID.
  try:
    os.killpg(child.pid, signal.SIGTERM)
  except ProcessLookupError:
    return
  try:
    child.wait(timeout=3)
  except subprocess.TimeoutExpired:
    pass
  # Kill surviving descendants too, even if the immediate child exited.
  try:
    os.killpg(child.pid, signal.SIGKILL)
  except ProcessLookupError:
    pass
  child.wait()

thermal = None
next_sample = 0

def sample():
  global next_sample
  now = time.monotonic()
  if thermal is None or now < next_sample:
    return
  next_sample = now + request['thermals']
  paths = sorted(set(sysfs.glob('class/hwmon/hwmon*/temp*_input')) |
                 set(sysfs.glob('class/thermal/thermal_zone*/temp')))
  for path in paths:
    try:
      temperature = int(path.read_text().strip())
    except (OSError, ValueError):
      continue
    writer.writerow([time.time(), str(path.relative_to(sysfs)), temperature])
  thermal.flush()

try:
  # Serialize runs even when one holder invokes bench twice or its lease
  # expires mid-run. Unlinking this stable file would defeat flock.
  bench_lock = (root / 'run.lock').open('a')
  try:
    fcntl.flock(bench_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
  except BlockingIOError:
    raise RuntimeError('another bench run is active; wait for its cleanup')
  directory = root / ('run-' + time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())
                      + '-' + uuid.uuid4().hex)
  directory.mkdir(mode=0o700)
  # Only direct run directories are candidates; rmtree never traverses
  # nested symlinks. Keep the current run even if old mtimes are in future.
  runs = sorted((p for p in root.glob('run-*')
                 if not p.is_symlink() and p.is_dir() and p != directory),
                key=lambda p: (p.stat().st_mtime_ns, p.name), reverse=True)
  for old in runs[request['keep_runs'] - 1:]:
    shutil.rmtree(old)
  (directory / 'stdout.log').touch()
  (directory / 'stderr.log').touch()
  print(json.dumps({'remote_directory': str(directory)}), flush=True)
  before = governors()
  save('governors-before.json', before)
  power_before = power()
  save('power-before.json', power_before)
  if request['require_power'] and not power_before['external_power']:
    raise RuntimeError('--require-power needs confirmed external power')
  if request['cpus'] and not shutil.which('taskset'):
    raise RuntimeError('--cpus needs taskset on the device')
  if request['pin_governor']:
    if not before:
      raise RuntimeError('cannot read CPU governors; refusing to pin')
    # Verify noninteractive permission for restoration before any pinning.
    # Writing the original values also checks helper availability per CPU.
    for cpu, value in before.items():
      set_governor(cpu, value)
    modified = True
    for cpu in before:
      if cancel.is_set():
        raise RuntimeError('interrupted before benchmark start')
      set_governor(cpu, 'performance')
  during = governors()
  save('governors-during.json', during)
  if request['pin_governor'] and (
      set(before) != set(during) or
      any(value != 'performance' for value in during.values())):
    raise RuntimeError('not every CPU governor was pinned to performance')
  argv = request['command']
  if request['cpus']:
    argv = ['taskset', '--cpu-list', request['cpus'], *argv]
  if perf:
    argv = ['perf', 'stat', '-x,', '-o', str(directory / 'perf-stat.csv'),
            '--', *argv]
  if request['thermals'] is not None:
    thermal = (directory / 'thermals.csv').open('w', newline='')
    writer = csv.writer(thermal)
    writer.writerow(['device_time', 'sensor', 'millidegrees_celsius'])
  with (directory / 'stdout.log').open('wb') as stdout, \
       (directory / 'stderr.log').open('wb') as stderr:
    if cancel.is_set():
      raise RuntimeError('connection closed before benchmark start')
    started = time.time()
    sample()
    try:
      child = subprocess.Popen(argv, stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               start_new_session=True)
    except OSError as exc:
      stderr.write((str(exc) + '\n').encode())
      status = 127 if isinstance(exc, FileNotFoundError) else 126
    # Drain both pipes without blocking heartbeat/signal handling. Discard
    # excess bytes so a noisy command can finish without growing its logs.
    streams = []
    if child is not None:
      for pipe, log in ((child.stdout, stdout), (child.stderr, stderr)):
        os.set_blocking(pipe.fileno(), False)
        streams.append([pipe, log, 0, False])
    limit = 64 * 1024 * 1024
    note = b'\n[steamos: log truncated at 64 MiB]\n'
    def drain():
      for stream in streams:
        pipe, log, size, truncated = stream
        for _ in range(16):
          try:
            data = os.read(pipe.fileno(), 65536)
          except BlockingIOError:
            break
          if not data:
            break
          if not truncated:
            kept = data[:max(0, limit - size)]
            log.write(kept)
            size += len(kept)
            if len(kept) < len(data):
              log.seek(limit - len(note))
              log.write(note)
              truncated = True
        stream[2:] = [size, truncated]
    while child is not None and child.poll() is None:
      drain()
      if cancel.is_set() or time.monotonic() - last_heartbeat > 5:
        stop_command()
        status = 128 + (interruption or signal.SIGHUP)
        break
      sample()
      time.sleep(.02)
    if status is None:
      status = child.returncode
      if status < 0:
        status = 128 - status
    stop_command()
    drain()
    for pipe, _, _, _ in streams:
      pipe.close()
    ended = time.time()
except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
  error = str(exc)
finally:
  if directory is None:
    print(json.dumps({'error': error}), flush=True)
    sys.exit(0)
  # Ignore further signals only during bounded cleanup. Restoration tries
  # every CPU even when an earlier write failed; its read-back is evidence.
  for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
    signal.signal(signum, signal.SIG_IGN)
  stop_command()
  if modified:
    for cpu, value in before.items():
      try:
        set_governor(cpu, value)
      except RuntimeError as exc:
        error += ('; ' if error else '') + 'failed to restore: ' + str(exc)
  try:
    after = governors()
    power_after = power()
  except (OSError, RuntimeError) as exc:
    error += ('; ' if error else '') + 'after snapshot failed: ' + str(exc)
  restored = not modified or before == after
  if not restored and 'restore' not in error:
    error += ('; ' if error else '') + 'governor restore read-back differs'
  save('governors-after.json', after)
  save('power-after.json', power_after)
  if thermal is not None:
    thermal.close()
  ended = time.time()
  result = {
    'remote_directory': str(directory), 'command': request['command'],
    'exit_status': status, 'start_device_time': started,
    'end_device_time': ended, 'restoration_ok': restored,
    'governors': {'before': before, 'during': during, 'after': after},
    'power': {'before': power_before, 'after': power_after},
    'perf_stat': perf, 'thermals': request['thermals'], 'error': error}
  save('summary.json', result)
  result['files'] = sorted(p.name for p in directory.iterdir() if p.is_file())
  print(json.dumps(result), flush=True)
'''


def cpu_list(value):
  if not re.fullmatch(r'[0-9]+(?:-[0-9]+)?(?:,[0-9]+(?:-[0-9]+)?)*', value):
    raise Failure(USAGE, '--cpus needs a CPU list such as 0,2-3')
  ranges = []
  for part in value.split(','):
    try:
      ends = [int(n) for n in part.split('-')]
    except ValueError:
      raise Failure(USAGE, '--cpus has an invalid CPU number')
    low, high = ends[0], ends[-1]
    if low > high or any(low <= b and high >= a for a, b in ranges):
      raise Failure(USAGE, '--cpus has reversed or overlapping CPU ranges')
    ranges.append((low, high))
  return value


def bench_ssh(entry, request):
  """One live stdin transport; never embed COMMAND in a shell command."""
  remote = 'python3 -c ' + shlex.quote(BENCH_SCRIPT)
  options = ssh_options(entry) + ['-o', 'ServerAliveInterval=2',
                                '-o', 'ServerAliveCountMax=3']
  errors = []
  for address in targets(entry):
    proc = subprocess.Popen(
      ['ssh', *options, f'{entry["user"]}@{address}', remote],
      stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
      text=True)
    stopped = threading.Event()
    output, diagnostics = [], []

    def send():
      try:
        proc.stdin.write(json.dumps(request) + '\n')
        proc.stdin.flush()
        while not stopped.wait(.5):
          proc.stdin.write('heartbeat\n')
          proc.stdin.flush()
      except (BrokenPipeError, OSError):
        pass
      finally:
        try:
          proc.stdin.close()
        except OSError:
          pass

    def read(stream, target):
      target.append(stream.read())
      stream.close()

    threads = [threading.Thread(target=send),
               threading.Thread(target=read, args=(proc.stdout, output)),
               threading.Thread(target=read, args=(proc.stderr, diagnostics))]
    previous = {}
    try:
      # Host interruptions close stdin; the device owns cancellation and
      # restoration. Keep reading until the final receipt/transport exit.
      for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        previous[signum] = signal.signal(signum, lambda *_: stopped.set())
      for thread in threads:
        thread.start()
      proc.wait()
    finally:
      stopped.set()
      for thread in threads:
        if thread.ident is not None:
          thread.join()
      for signum, handler in previous.items():
        signal.signal(signum, handler)
    stdout, stderr = ''.join(output), ''.join(diagnostics)
    if proc.returncode != 255:
      return subprocess.CompletedProcess(proc.args, proc.returncode,
                                         stdout, stderr)
    if 'connected=1' in stdout.splitlines():
      location = ''
      for line in stdout.splitlines()[1:]:
        try:
          location = json.loads(line).get('remote_directory', location)
        except (ValueError, AttributeError):
          pass
      where = location or 'the device run directory'
      raise Failure(UNREACHABLE, 'connection dropped during bench; device '
                    f'cleanup attempts governor restoration. Inspect {where} '
                    'and `steamos lease show` before retrying')
    errors.append(f'{address}: {stderr.strip()}')
  raise Failure(UNREACHABLE, 'cannot reach device for bench:\n  ' +
                '\n  '.join(errors))


def bench_command(options):
  command = options.argv
  if not command or command[0] != '--' or len(command) < 2:
    raise Failure(USAGE, 'bench run needs -- COMMAND [ARGS...]')
  command = command[1:]
  if not command[0] or any('\0' in arg for arg in command):
    raise Failure(USAGE, 'COMMAND must be nonempty and argv must not have NUL')
  if options.cpus is not None:
    cpu_list(options.cpus)
  if options.thermals is not None and not 0 < options.thermals < float('inf'):
    raise Failure(USAGE, '--thermals must be a finite interval above zero')
  config = load_config()
  name, entry = device(config, options.device)
  bench = config.get('bench', {})
  if not isinstance(bench, dict):
    raise Failure(USAGE, 'bench configuration must be an object')
  keep_runs = bench.get('keep_runs', 20)
  helper = bench.get('governor_helper', '/etc/agent-kit/steamos-governor')
  if type(keep_runs) is not int or keep_runs < 1:
    raise Failure(USAGE, 'bench.keep_runs must be a positive integer')
  if not isinstance(helper, str) or not helper.startswith('/') or '\0' in helper:
    raise Failure(USAGE, 'bench.governor_helper must be an absolute path')
  output = output_path(options.out or (
    './steamos-bench-' + name + '-' +
    time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())))
  if output.exists():
    raise Failure(USAGE, '--out must name a new run directory')
  if not output.parent.is_dir():
    raise Failure(USAGE, '--out needs an existing parent directory')
  if not shutil.which('scp'):
    raise Failure(USAGE, 'scp is needed to download benchmark results')
  require_lease(config, name, entry, 'bench run')
  request = {'command': command, 'pin_governor': options.pin_governor,
             'require_power': options.require_power, 'cpus': options.cpus,
             'perf_stat': options.perf_stat, 'thermals': options.thermals,
             'keep_runs': keep_runs, 'governor_helper': helper}
  proc = bench_ssh(entry, request)
  if proc.returncode != 0:
    raise Failure(UNREACHABLE, 'device benchmark supervisor failed: ' +
                  proc.stderr.strip())
  try:
    reply = json.loads(proc.stdout.strip().splitlines()[-1])
  except (ValueError, IndexError):
    raise Failure(UNREACHABLE, 'bench returned no final summary')
  if not isinstance(reply, dict):
    raise Failure(UNREACHABLE, 'bench returned an invalid summary')
  if set(reply) == {'error'} and isinstance(reply['error'], str):
    raise Failure(REFUSED, reply['error'])
  remote = reply.get('remote_directory', '')
  files = reply.pop('files', [])
  allowed = {'summary.json', 'stdout.log', 'stderr.log', 'perf-stat.csv',
             'thermals.csv', 'governors-before.json', 'governors-during.json',
             'governors-after.json', 'power-before.json', 'power-after.json'}
  if not re.fullmatch(
      r'/[A-Za-z0-9._/-]+/\.agent-kit-steamos-bench/run-[A-Za-z0-9-]+',
      remote) or '..' in Path(remote).parts or not isinstance(files, list) \
      or any(not isinstance(f, str) or f not in allowed for f in files) \
      or 'summary.json' not in files:
    raise Failure(UNREACHABLE, 'bench returned unsafe or incomplete run paths')
  try:
    output.mkdir()
  except OSError as error:
    raise Failure(USAGE, f'cannot create --out directory: {error}')
  for filename in files:
    pull_file(entry, remote + '/' + filename, output / filename)
  reply.update(device=name, output=str(output))
  if reply.get('error'):
    reply['error'] = error_text(reply['error'])
    print('steamos: ' + reply['error'], file=sys.stderr)
  if options.perf_stat and not reply.get('perf_stat'):
    print('steamos: perf is unavailable; ran without perf stat', file=sys.stderr)
  print(json.dumps(reply, indent=2) if options.json else
        f'{name}: benchmark exit={reply.get("exit_status")}; '
        f'governors restored={reply.get("restoration_ok")}; '
        f'results: {output}')
  if reply.get('exit_status') not in (None, 0):
    return BENCH_FAILED
  if reply.get('error') or not reply.get('restoration_ok') or \
      reply.get('exit_status') is None:
    return REFUSED
  return OK


def main(argv=None):
  parser = argparse.ArgumentParser(prog='steamos', description=__doc__)
  parser.add_argument('--device', help='configured device name')
  parser.add_argument('--json', action='store_true')
  commands = parser.add_subparsers(dest='command', required=True)
  status = commands.add_parser('status', help='device facts and its lease')
  status.add_argument('--project', help='project directory (default: from cwd)')
  stage = commands.add_parser('stage', help='verify a project bundle locally')
  stage.add_argument('--project', help='project directory (default: from cwd)')
  deploy = commands.add_parser('deploy', help='publish a verified version')
  deploy.add_argument('--project', help='project directory (default: from cwd)')
  mode = deploy.add_mutually_exclusive_group()
  mode.add_argument('--rollback', action='store_true')
  mode.add_argument('--list', action='store_true')
  mode.add_argument('--abort-stale', action='store_true',
                    help='remove an abandoned deploy lock and partials')
  lease = commands.add_parser('lease', help='share a device between agents')
  actions = lease.add_subparsers(dest='action', required=True)
  for action, text in (('take', 'take or renew the lease'),
                       ('renew', 'extend a lease you hold'),
                       ('show', 'who holds the lease'),
                       ('check', 'succeed only if the lease is yours'),
                       ('release', 'give up a lease you hold'),
                       ('break', 'remove a lease you do not hold')):
    sub = actions.add_parser(action, help=text)
    if action == 'take':
      sub.add_argument('purpose')
    if action in ('take', 'renew'):
      sub.add_argument('--hours', type=float)
    if action == 'break':
      sub.add_argument('--reason')
    common_options(sub)
  devkit = commands.add_parser('devkit', help="Valve's device-side helpers")
  devkit_actions = devkit.add_subparsers(dest='action', required=True)
  install = devkit_actions.add_parser(
    'install', help='copy the pinned devkit-utils to the device')
  title = commands.add_parser('title', help='register and run Steam titles')
  title_actions = title.add_subparsers(dest='action', required=True)
  for action in ('register', 'launch', 'remove', 'list'):
    sub = title_actions.add_parser(action)
    if action != 'list':
      sub.add_argument('name')
    if action == 'register':
      sub.add_argument('directory')
      sub.add_argument('--start', required=True, help='start path inside DIR')
      sub.add_argument('--arg', action='append', default=[])
      sub.add_argument('--runtime', choices=('slr4', 'none'), default='slr4')
    common_options(sub)
  wake = commands.add_parser('wake', help='wake a wired device over LAN')
  wake.add_argument('--wait', type=int, default=60, help='seconds to await ssh')
  logs = commands.add_parser('logs', help='read the latest launch window')
  logs.add_argument('name', nargs='?')
  logs.add_argument('--since', type=int, help='start epoch (device clock)')
  logs.add_argument('--until', type=int, help='end epoch (default: device now)')
  logs.add_argument('--lines', type=int, default=200, help='last N lines')
  capture = commands.add_parser('capture', help='capture a gamescope PNG')
  capture.add_argument('--out', help='local PNG file')
  bench = commands.add_parser('bench', help='run a device benchmark')
  bench_actions = bench.add_subparsers(dest='action', required=True)
  run = bench_actions.add_parser('run')
  run.add_argument('--pin-governor', action='store_true')
  run.add_argument('--require-power', action='store_true')
  run.add_argument('--cpus', help='taskset CPU list, e.g. 0,2-3')
  run.add_argument('--perf-stat', action='store_true')
  run.add_argument('--thermals', type=float,
                   help='sampling interval in seconds')
  run.add_argument('--out', help='new local run directory')
  run.add_argument('argv', nargs=argparse.REMAINDER)
  common_options(run)
  frametimes = commands.add_parser('frametimes', help='MangoHud CSV logging')
  frame_actions = frametimes.add_subparsers(dest='action', required=True)
  for action in ('start', 'stop', 'pull'):
    sub = frame_actions.add_parser(action)
    if action == 'pull':
      sub.add_argument('--out', help='local directory (default: current)')
      sub.add_argument('--partial', action='store_true',
                       help='allow a session without its summary CSV')
    common_options(sub)
  for sub in (status, lease, devkit, install, title, wake, logs, capture,
              frametimes, bench, stage, deploy):
    common_options(sub)
  options = parser.parse_args(argv)
  options.hours = getattr(options, 'hours', None)
  try:
    if options.command == 'stage':
      return stage_command(options)
    if options.command == 'deploy':
      return deploy_command(options)
    if options.command == 'status':
      return status_command(options)
    if options.command == 'devkit':
      return devkit_command(options)
    if options.command == 'title':
      return title_command(options)
    if options.command == 'wake':
      return wake_command(options)
    if options.command == 'logs':
      return logs_command(options)
    if options.command == 'capture':
      return capture_command(options)
    if options.command == 'frametimes':
      return frametimes_command(options)
    if options.command == 'bench':
      return bench_command(options)
    return lease_command(options)
  except Failure as failure:
    print(f'steamos: {failure}', file=sys.stderr)
    return failure.code


def common_options(parser):
  # Suppress subparser defaults so global options survive at every level.
  parser.add_argument('--device', default=argparse.SUPPRESS,
                      help=argparse.SUPPRESS)
  parser.add_argument('--json', action='store_true',
                      default=argparse.SUPPRESS)


if __name__ == '__main__':
  sys.exit(main())
