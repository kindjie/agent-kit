#!/usr/bin/env python3
"""Run the explicit-state exclusive-lane scheduler pilot."""
import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent))
from agent_scheduler import SchedulerError, main

if __name__ == '__main__':
  try:
    sys.exit(main())
  except (SchedulerError, OSError, ValueError) as exc:
    print('agent-scheduler: ' + str(exc), file=sys.stderr)
    sys.exit(1)
