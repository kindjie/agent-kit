#!/usr/bin/env python3
"""Cooperative machine-local admission around foreground process groups."""
import argparse
import fcntl
import math
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import time


def seconds(value):
  number = float(value)
  if not math.isfinite(number) or number <= 0:
    raise argparse.ArgumentTypeError('expected finite positive seconds')
  return number


def secure_directory():
  root = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state'))
  root = root / 'agent-kit' / 'resources'
  root.mkdir(mode=0o700, parents=True, exist_ok=True)
  info = root.lstat()
  if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or
      info.st_mode & 0o077):
    raise OSError('resource directory must be owned by you and mode 0700')
  return root


def acquire(root, names, deadline):
  handles = []
  try:
    for name in sorted(set(names)):
      fd = os.open(root / (name + '.lock'),
                   os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
      handles.append(fd)
      info = os.fstat(fd)
      if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or
          info.st_mode & 0o077 or info.st_nlink != 1):
        raise OSError('unsafe resource lock')
      while True:
        try:
          fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
          break
        except BlockingIOError:
          remaining = deadline - time.monotonic()
          if remaining <= 0:
            raise TimeoutError('resource wait expired')
          time.sleep(min(.1, remaining))
    return handles
  except BaseException:
    for fd in handles:
      os.close(fd)
    raise


def group_alive(pid):
  try:
    os.killpg(pid, 0)
    return True
  except ProcessLookupError:
    return False
  except PermissionError:
    return True


def stop_group(proc):
  # Keep admission until the whole group disappears, not just its leader.
  for sig, grace in ((signal.SIGTERM, .5), (signal.SIGKILL, 0)):
    proc.poll()  # Reap an exited leader before signalling on macOS.
    try:
      os.killpg(proc.pid, sig)
    except ProcessLookupError:
      break
    except PermissionError:
      if proc.poll() is None:
        print('cannot signal child group; retaining admission until exit',
              file=sys.stderr)
    if grace:
      time.sleep(grace)
  warned = False
  deadline = time.monotonic() + 5
  while True:
    proc.poll()
    if not group_alive(proc.pid):
      break
    if not warned and time.monotonic() >= deadline:
      print('child group still exists; retaining admission until exit',
            file=sys.stderr)
      warned = True
    time.sleep(.1)
  proc.wait()


def main():
  parser = argparse.ArgumentParser(description=__doc__)
  commands = parser.add_subparsers(dest='action', required=True)
  run = commands.add_parser('run')
  run.add_argument('--resource', action='append', required=True)
  run.add_argument('--wait', type=seconds, default=600)
  run.add_argument('--timeout', type=seconds, default=3600)
  run.add_argument('command', nargs=argparse.REMAINDER)
  args = parser.parse_args()
  command = args.command[1:] if args.command[:1] == ['--'] else args.command
  if not command or any(not re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}', n)
                        for n in args.resource):
    parser.error('a command and simple resource names are required')
  handles, proc = [], None
  def interrupted(signum, frame):
    raise InterruptedError(signum)
  for sig in (signal.SIGINT, signal.SIGTERM):
    signal.signal(sig, interrupted)
  try:
    handles = acquire(secure_directory(), args.resource,
                      time.monotonic() + args.wait)
    proc = subprocess.Popen(command, start_new_session=True, pass_fds=handles)
    try:
      result = proc.wait(timeout=args.timeout)
    except subprocess.TimeoutExpired:
      result = 124
    return result if result >= 0 else 128 - result
  except TimeoutError:
    print('resource wait expired; command was not started', file=sys.stderr)
    return 75
  except InterruptedError as exc:
    return 128 + exc.args[0]
  except OSError as exc:
    print(str(exc), file=sys.stderr)
    return 1
  finally:
    # A second interrupt must not release admission during child cleanup.
    for sig in (signal.SIGINT, signal.SIGTERM):
      signal.signal(sig, signal.SIG_IGN)
    if proc is not None:
      stop_group(proc)
    for fd in handles:
      os.close(fd)


if __name__ == '__main__':
  sys.exit(main())
